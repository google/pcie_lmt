# proto-file: ltt/ltt.proto
# proto-message: ltt.LinkTrain

link_target {
  usp_vendor_id: 0x1000
  usp_device_id: 0xc030
  usp_bdfs: "0000:81:00.0"
  usp_bdfs: "0000:a1:00.0"
}

iterations: 100
method: M_REENABLE  # Other options are M_SBR or M_RETRAIN_DEFAULT
training_wait_ms: 1000

continue: true
parallel: true

recover_pci_config_space_header: true
recover_pcie_cap_ctrl_regs: true
recover_sriov_cap_regs: true

field: {
  name: "VendorID"
  state: S_LOG
  addr: 0x0
  size: UINT16
  mask: 0xFFFF
}

field: {
  name: "DeviceID"
  state: S_LOG
  addr: 0x02
  size: UINT16
  mask: 0xFFFF
}

field: {
  name: "Speed"
  state: S_CHECK
  addr: 0x92
  size: UINT16
  mask: 0x000F
  expected: 0x0005
}

field: {
  name: "Width"
  state: S_CHECK
  addr: 0x92
  size: UINT16
  mask: 0x03F0
  expected: 0x0080
}

############################################################
